#!/bin/bash

# Configuration
REMOTE_USER="sergio"
REMOTE_IP="pacr-voyager"
LOCAL_DEST="${2:-.}"

# Check if a directory path was provided as an argument
if [ -z "$1" ]; then
    echo "Error: No directory specified."
    echo "Usage: $0 /path/to/remote/directory LOCAL_DESTINATION"
    echo "LOCAL_DESTINATION is optional. Defaults to current directory"
    exit 1
fi

REMOTE_DIR="$1"
echo "Transferring '$REMOTE_DIR' to $LOCAL_DEST..."

# Execute recursive SCP to the local machine
scp -r "$REMOTE_USER@$REMOTE_IP:$REMOTE_DIR" "$LOCAL_DEST"

# Check if the scp command succeeded
if [ $? -eq 0 ]; then
    echo "Success: Directory transferred successfully!"
else
    echo "Error: Transfer failed. Check your network or SSH configuration."
fi
